// L2 topology (rails as nodes) for instance 'spike'
digraph l2_topology_per_rail_spike {
	mclimit=10.0 nodesep=0.15 overlap=false rankdir=LR ranksep=0.35 splines=polyline
	node [fontname=Helvetica fontsize=10 style="filled,rounded"]
	edge [fontname=Helvetica fontsize=9]
	role__ACHOrigSettlement [label=ACHOrigSettlement color="#1f4e79" fillcolor="#dbe9f6" fontcolor="#1f4e79" shape=cylinder]
	role__CashDueFRB [label=CashDueFRB color="#1f4e79" fillcolor="#dbe9f6" fontcolor="#1f4e79" shape=cylinder]
	role__ConcentrationMaster [label=ConcentrationMaster color="#1f4e79" fillcolor="#dbe9f6" fontcolor="#1f4e79" shape=cylinder]
	role__CustomerDDA [label=CustomerDDA color="#1f4e79" fillcolor="#e8f0ff" fontcolor="#1f4e79" shape=folder]
	role__DDAControl [label=DDAControl color="#1f4e79" fillcolor="#dbe9f6" fontcolor="#1f4e79" shape=cylinder]
	role__ExternalCardNetwork [label=ExternalCardNetwork color="#7f6000" fillcolor="#fff2cc" fontcolor="#7f6000" shape=note]
	role__ExternalCounterparty [label=ExternalCounterparty color="#7f6000" fillcolor="#fff2cc" fontcolor="#7f6000" shape=note]
	role__InternalSuspenseRecon [label=InternalSuspenseRecon color="#1f4e79" fillcolor="#dbe9f6" fontcolor="#1f4e79" shape=cylinder]
	role__InternalTransferSuspense [label=InternalTransferSuspense color="#1f4e79" fillcolor="#dbe9f6" fontcolor="#1f4e79" shape=cylinder]
	role__MerchantDDA [label=MerchantDDA color="#1f4e79" fillcolor="#e8f0ff" fontcolor="#1f4e79" shape=folder]
	role__MerchantDDAControl [label=MerchantDDAControl color="#1f4e79" fillcolor="#dbe9f6" fontcolor="#1f4e79" shape=cylinder]
	role__MerchantPayableClearing [label=MerchantPayableClearing color="#1f4e79" fillcolor="#dbe9f6" fontcolor="#1f4e79" shape=cylinder]
	role__WireSettlementSuspense [label=WireSettlementSuspense color="#1f4e79" fillcolor="#dbe9f6" fontcolor="#1f4e79" shape=cylinder]
	role__ZBASubAccount [label=ZBASubAccount color="#1f4e79" fillcolor="#e8f0ff" fontcolor="#1f4e79" shape=folder]
	tmpl__InternalTransferCycle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#ffcc99" PORT="hdr"><B>InternalTransferCycle</B><BR/><FONT POINT-SIZE="8">internal_transfer_id</FONT></TD></TR>
  <TR><TD BGCOLOR="#fff2e0" PORT="leg_InternalTransferDebit" ALIGN="LEFT">InternalTransferDebit  (D)</TD></TR>
  <TR><TD BGCOLOR="#fff2e0" PORT="leg_InternalTransferCredit" ALIGN="LEFT">InternalTransferCredit  (C)</TD></TR>
  <TR><TD BGCOLOR="#fff2e0" PORT="leg_InternalTransferSuspenseClose" ALIGN="LEFT">InternalTransferSuspenseClose  (V)</TD></TR>
</TABLE>> shape=plaintext]
	tmpl__MerchantSettlementCycle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#ffcc99" PORT="hdr"><B>MerchantSettlementCycle</B><BR/><FONT POINT-SIZE="8">merchant_id, settlement_period</FONT></TD></TR>
  <TR><TD BGCOLOR="#ffe1c2" PORT="leg_SettlementAutoSettle" ALIGN="LEFT">SettlementAutoSettle  (V)</TD></TR>
  <TR><TD BGCOLOR="#ffe1c2" PORT="leg_SettlementStandardSettle" ALIGN="LEFT">SettlementStandardSettle  (V)</TD></TR>
  <TR><TD BGCOLOR="#ffe1c2" PORT="leg_SettlementSlowSettle" ALIGN="LEFT">SettlementSlowSettle  (V)</TD></TR>
  <TR><TD BGCOLOR="#ffe1c2" PORT="leg_NoFraudReview" ALIGN="LEFT">NoFraudReview  (V)</TD></TR>
  <TR><TD BGCOLOR="#ffe1c2" PORT="leg_StandardFraudReview" ALIGN="LEFT">StandardFraudReview  (V)</TD></TR>
  <TR><TD BGCOLOR="#ffe1c2" PORT="leg_EnhancedFraudReview" ALIGN="LEFT">EnhancedFraudReview  (V)</TD></TR>
  <TR><TD BGCOLOR="#fff2e0" PORT="leg_MerchantCardSale" ALIGN="LEFT">MerchantCardSale  (↔)</TD></TR>
</TABLE>> shape=plaintext]
	tmpl__MerchantWeeklyPayoutBatch [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#ffcc99" PORT="hdr"><B>MerchantWeeklyPayoutBatch</B><BR/><FONT POINT-SIZE="8">merchant_id, payout_batch_id</FONT></TD></TR>
  <TR><TD BGCOLOR="#fff2e0" PORT="leg_MerchantWeeklyBatchClose" ALIGN="LEFT">MerchantWeeklyBatchClose  (C)</TD></TR>
</TABLE>> shape=plaintext]
	rail__CustomerInboundACH [label=CustomerInboundACH color="#666666" fillcolor="#f5f5f5" fontcolor="#666666" peripheries=2 shape=cds style=filled]
