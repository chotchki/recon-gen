	rail__InternalBalanceMaintenance -> role__InternalSuspenseRecon [arrowhead=normal color="#1b9e77"]
	role__CustomerDDA -> rail__CustomerInboundACHReturnNSF [arrowhead=normal color="#d95f02"]
	rail__CustomerInboundACHReturnNSF -> role__ExternalCounterparty [arrowhead=normal color="#1b9e77"]
	role__CustomerDDA -> rail__CustomerInboundACHReturnStopPay [arrowhead=normal color="#d95f02"]
	rail__CustomerInboundACHReturnStopPay -> role__ExternalCounterparty [arrowhead=normal color="#1b9e77"]
	role__ExternalCardNetwork -> tmpl__MerchantSettlementCycle:leg_MerchantCardSale:w [arrowhead=normal color="#d95f02"]
	tmpl__MerchantSettlementCycle:leg_MerchantCardSale:e -> role__MerchantPayableClearing [arrowhead=normal color="#1b9e77"]
	role__MerchantPayableClearing -> rail__MerchantPayoutACH [arrowhead=normal color="#d95f02"]
	rail__MerchantPayoutACH -> role__MerchantDDA [arrowhead=normal color="#1b9e77"]
