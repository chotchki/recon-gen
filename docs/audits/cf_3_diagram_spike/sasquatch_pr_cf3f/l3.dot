	rail__CustomerInboundACH -> role__CustomerDDA [arrowhead=normal color="#1b9e77"]
	role__CustomerDDA -> tmpl__InternalTransferCycle:leg_InternalTransferDebit:w [arrowhead=normal color="#d95f02"]
	tmpl__InternalTransferCycle:leg_InternalTransferCredit:e -> role__CustomerDDA [arrowhead=normal color="#1b9e77"]
	role__InternalTransferSuspense -> tmpl__InternalTransferCycle:leg_InternalTransferSuspenseClose:w [arrowhead=normal color="#7570b3"]
